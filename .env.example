# 複製這個檔案成 ".env"，再依需要修改。（.env 不要上傳到公開的地方）

# 教師後台密碼（必填，至少 8 個字元）。沒設定的話，後台無法登入。
ADMIN_PASSWORD=請改成你自己的密碼

# 伺服器連接埠（預設 3000）
PORT=3000

# 資料庫與備份存放的資料夾（預設 ./data）。部署到雲端時，請指向「永久儲存空間」。
# DATA_DIR=/data

# 放在 Nginx / Cloudflare / 雲端平台的反向代理後面時設為 1，才能抓到學生真正的 IP
# TRUST_PROXY=1

# 網站使用 https 時設為 1，後台 Cookie 會加上 Secure
# COOKIE_SECURE=1
