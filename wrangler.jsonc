{
  // Cloudflare Workers 設定檔
  // 「name」必須和 Cloudflare 後台的 Worker 名稱一樣
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rights-power-game",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rights-power-db",
      // 在 Cloudflare 後台建立 D1 資料庫後，把它的 Database ID 貼在這裡
      "database_id": "8274b07e-db58-4840-80f7-3731619a2ca9"
    }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.csv"], "fallthrough": true }],
  "observability": { "enabled": true }
  // 後台密碼不要寫在這裡！請在 Cloudflare 後台 → 這個 Worker → Settings → Variables and Secrets
  // 新增一個「Secret」，名稱 ADMIN_PASSWORD
}
